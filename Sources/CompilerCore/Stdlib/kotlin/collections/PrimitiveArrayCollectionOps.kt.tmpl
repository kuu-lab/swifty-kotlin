public infix fun <R> {{T}}Array.zip(other: Iterable<R>): List<Pair<{{T}}, R>> {
    val result = mutableListOf<Pair<{{T}}, R>>()
    var index = 0
    for (element in other) {
        if (index >= size) break
        result.add(Pair(this[index++], element))
    }
    return result
}

