public fun {{T}}Array.reduce(operation: ({{T}}, {{T}}) -> {{T}}): {{T}} {
    if (this.size == 0) throw UnsupportedOperationException("Empty array can't be reduced.")
    var acc = this[0]
    var i = 1
    while (i < this.size) {
        acc = operation(acc, this[i])
        i++
    }
    return acc
}

