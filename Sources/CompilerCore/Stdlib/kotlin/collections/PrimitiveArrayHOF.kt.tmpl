// Primitive-array HOF skeletons: one body stamped once per element type (the
// format is documented on BundledStdlibTemplate). The outputs were originally
// byte-identical to the hand-written PrimitiveArrayHOF*.kt files they replaced,
// drift included, so declaration order and SymbolIDs did not move. Remaining
// drift is marked with //@ note lines; normalizing it is a behavior change and
// belongs in a separate change with diff cases.
//@ file PrimitiveArrayHOF Int Long
//@ file PrimitiveArrayHOF+ByteShort Byte Short
//@ file PrimitiveArrayHOF+DoubleFloat Double Float
//@ file PrimitiveArrayHOF+BooleanChar Boolean Char
//@ file PrimitiveArrayHOF+UByteUShort UByte UShort
//@ file PrimitiveArrayHOF+UIntULong UInt ULong
//@ header
package kotlin.collections

// The generated-looking repetition mirrors Kotlin's specialized primitive-array API
// and keeps element values typed at the source boundary instead of passing raw words
// through the former kk_array_* runtime HOF bridges.

//@ body
//@ note The unsigned arrays carry extra accessors ahead of the shared HOFs.
//@ only UByte UShort UInt ULong
public fun {{T}}Array.elementAt(index: Int): {{T}} = this[index]

public fun {{T}}Array.getOrNull(index: Int): {{T}}? =
    if (index >= 0 && index < size) this[index] else null

public inline fun {{T}}Array.elementAtOrElse(index: Int, defaultValue: (Int) -> {{T}}): {{T}} =
    if (index >= 0 && index < size) this[index] else defaultValue(index)

//@ end
//@ only UByte UShort UInt ULong
public fun {{T}}Array.indexOf(element: {{T}}): Int {
    var i = 0
    while (i < this.size) {
        if (this[i] == element) return i
        i++
    }
    return -1
}

//@ end
//@ only UByte UShort UInt ULong
public inline fun {{T}}Array.indexOfFirst(predicate: ({{T}}) -> Boolean): Int {
    var i = 0
    while (i < this.size) {
        if (predicate(this[i])) return i
        i++
    }
    return -1
}

public inline fun {{T}}Array.indexOfLast(predicate: ({{T}}) -> Boolean): Int {
    var i = this.size - 1
    while (i >= 0) {
        if (predicate(this[i])) return i
        i--
    }
    return -1
}

//@ end
//@ only UByte UShort UInt ULong
public inline fun {{T}}Array.forEachIndexed(action: (Int, {{T}}) -> Unit) {
    var i = 0
    while (i < this.size) {
        action(i, this[i])
        i++
    }
}

public fun {{T}}Array.max(): {{T}} = maxOrNull() ?: throw NoSuchElementException()

public fun {{T}}Array.maxOrNull(): {{T}}? {
    if (this.size == 0) return null
    var max = this[0]
    var i = 1
    while (i < this.size) {
        val element = this[i]
        if (element > max) max = element
        i++
    }
    return max
}

public fun {{T}}Array.min(): {{T}} = minOrNull() ?: throw NoSuchElementException()

public fun {{T}}Array.minOrNull(): {{T}}? {
    if (this.size == 0) return null
    var min = this[0]
    var i = 1
    while (i < this.size) {
        val element = this[i]
        if (element < min) min = element
        i++
    }
    return min
}

//@ end
public fun <R> {{T}}Array.map(transform: ({{T}}) -> R): List<R> {
    val result = mutableListOf<R>()
    var i = 0
    while (i < this.size) {
        result.add(transform(this[i]))
        i++
    }
    return result
}
