public fun {{T}}Array.isSorted(): Boolean {
    var index = 1
    while (index < size) {
//@ only Float Double
        // compareTo gives NaN and signed zeros the same order as sorting.
        if (this[index - 1].compareTo(this[index]) > 0) return false
//@ else
        if (this[index - 1] > this[index]) return false
//@ end
        index += 1
    }
    return true
}

